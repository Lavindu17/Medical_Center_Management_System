# Copy to .env.local and fill in. Never commit .env.local.

# --- MySQL -------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Use a dedicated least-privilege account in production, not root.
MYSQL_USER=sethro_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=sethro_medical

# --- Sessions ----------------------------------------------------------------
# REQUIRED. Long random string (for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# The app refuses to sign or accept sessions without it.
JWT_SECRET=

# --- Email (verification codes, password resets, family invitations) ----------
# Optional in development: without SMTP_USER/SMTP_PASS the emails are printed to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sethro Medical" <no-reply@example.com>

# Public URL used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Files -------------------------------------------------------------------
# Where lab reports are stored (a lab-reports/ folder is created inside). Keep it OUTSIDE public/.
# Defaults to ./private-uploads. On serverless or read-only hosts point this at persistent storage.
# UPLOAD_DIR=
